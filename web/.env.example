# Firebase Web App Configuration (copy this file to .env and fill with values from Firebase Console -> Project Settings -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Named Firestore Database ID used by MAATRAM CONNECT (matches Android firebase_applet_config.xml)
VITE_FIREBASE_DATABASE_ID=ai-studio-android-maatramc-01f1e4ac-a0ae-491a-9d08-d155a95dc9d9
